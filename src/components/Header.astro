---
const base = import.meta.env.BASE_URL;

const currentPath = Astro.url.pathname;

const links = [
  { href: base, label: "Home" },
  { href: `${base}experience`, label: "Experience" },
  { href: `${base}projects`, label: "Projects" },
  { href: `${base}articles`, label: "Articles" },
  { href: `${base}education`, label: "Education" },
];

const isActive = (href: string) => {
  if (href === base) {
    return currentPath === base || currentPath === `${base}/`;
  }

  return currentPath.startsWith(href);
};
---

<header class="site-header">
  <div class="header-container">

    <a href={base} class="brand">
      <span class="brand-mark">FS</span>
      <span class="brand-copy">
        <strong>Felipe Sales</strong>
        <small>Cloud · DevOps · SRE</small>
      </span>
    </a>

    <button
      class="menu-toggle"
      aria-label="Toggle navigation"
      aria-expanded="false"
      aria-controls="primary-navigation"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav class="nav" id="primary-navigation">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              "nav-link",
              { active: isActive(link.href) },
            ]}
          >
            {link.label}
          </a>
        ))
      }

      <a
        href={`${base}#contact`}
        class="contact-link"
      >
        Contact
      </a>
    </nav>

  </div>
</header>

<script>
  const menuToggle = document.querySelector(".menu-toggle");
  const nav = document.querySelector(".nav");

  menuToggle?.addEventListener("click", () => {
    const isOpen = nav?.classList.toggle("open");

    menuToggle.setAttribute(
      "aria-expanded",
      String(Boolean(isOpen))
    );

    menuToggle.setAttribute(
      "aria-label",
      isOpen ? "Close navigation" : "Open navigation"
    );

    document.documentElement.classList.toggle(
      "menu-open",
      Boolean(isOpen)
    );
  });

  document.querySelectorAll(".nav a").forEach((link) => {
    link.addEventListener("click", () => {
      nav?.classList.remove("open");

      menuToggle?.setAttribute(
        "aria-expanded",
        "false"
      );

      menuToggle?.setAttribute("aria-label", "Open navigation");
      document.documentElement.classList.remove("menu-open");
    });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || !nav?.classList.contains("open")) return;

    nav.classList.remove("open");
    menuToggle?.setAttribute("aria-expanded", "false");
    menuToggle?.setAttribute("aria-label", "Open navigation");
    menuToggle?.focus();
    document.documentElement.classList.remove("menu-open");
  });
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;

    z-index: 1000;

    width: 100%;

    border-bottom: 1px solid rgba(96, 165, 250, 0.12);

    background: rgba(2, 6, 23, 0.76);

    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .header-container {
    width: min(1180px, calc(100% - 48px));
    height: 78px;

    margin: 0 auto;

    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 11px;

    color: #f1f5f9;

    font-family: "Geist", Inter, sans-serif;

    text-decoration: none;

    transition: color 0.2s ease;
  }

  .brand-mark {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(96, 165, 250, 0.32);
    border-radius: 10px;
    background: linear-gradient(145deg, rgba(37, 99, 235, 0.24), rgba(124, 58, 237, 0.18));
    box-shadow: inset 0 1px rgba(255,255,255,.06), 0 8px 24px rgba(37,99,235,.12);
    color: #7dd3fc;
    font-family: "Geist Mono", monospace;
    font-size: 12px;
    font-weight: 600;
  }

  .brand:hover {
    color: #7dd3fc;
  }

  .brand-copy {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .brand-copy strong {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .brand-copy small {
    color: #64748b;
    font-family: "Geist Mono", monospace;
    font-size: 8px;
    font-weight: 500;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .nav {
    display: flex;
    align-items: center;

    gap: 25px;
  }

  .nav-link {
    position: relative;

    padding: 30px 0 28px;

    color: #94a3b8;

    font-family:
      "Geist Mono",
      monospace;

    font-size: 12px;

    text-decoration: none;

    transition: color 0.2s ease;
  }

  .nav-link::after {
    content: "";

    position: absolute;

    left: 0;
    bottom: 17px;

    width: 100%;
    height: 1px;

    background: linear-gradient(90deg, #3b82f6, #22d3ee, #8b5cf6);

    transform: scaleX(0);

    transform-origin: left;

    transition: transform 0.2s ease;
  }

  .nav-link:hover {
    color: #f1f5f9;
  }

  .nav-link.active {
    color: #7dd3fc;
  }

  .nav-link.active::after {
    transform: scaleX(1);
  }

  .contact-link {
    padding: 10px 15px;

    border: 1px solid rgba(96, 165, 250, 0.32);
    border-radius: 10px;

    background: linear-gradient(105deg, rgba(37,99,235,.18), rgba(124,58,237,.14));

    color: #bfdbfe;

    font-family:
      "Geist Mono",
      monospace;

    font-size: 11px;

    text-decoration: none;

    transition:
      background 0.2s ease,
      border-color 0.2s ease;
  }

  .contact-link:hover {
    border-color: rgba(125, 211, 252, 0.56);

    background: linear-gradient(105deg, rgba(37,99,235,.28), rgba(124,58,237,.2));
  }

  .menu-toggle {
    display: none;

    padding: 6px;

    border: 0;

    background: transparent;

    cursor: pointer;
  }

  .menu-toggle span {
    width: 22px;
    height: 1px;

    display: block;

    margin: 5px 0;

    background: #cbd5e1;

    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  @media (max-width: 700px) {
    :global(html.menu-open) {
      overflow: hidden;
    }

    .header-container {
      width: min(100% - 32px, 1100px);
      height: 70px;
    }

    .menu-toggle {
      width: 44px;
      height: 44px;
      display: grid;
      align-content: center;
      justify-items: center;
      flex: 0 0 auto;
      padding: 8px;
      border: 1px solid rgba(96, 165, 250, 0.18);
      border-radius: 11px;
      background: rgba(15, 23, 42, 0.58);
    }

    .menu-toggle span { margin: 3px 0; }

    .menu-toggle[aria-expanded="true"] span:first-child {
      transform: translateY(7px) rotate(45deg);
    }

    .menu-toggle[aria-expanded="true"] span:nth-child(2) {
      opacity: 0;
    }

    .menu-toggle[aria-expanded="true"] span:last-child {
      transform: translateY(-7px) rotate(-45deg);
    }

    .nav {
      position: absolute;

      top: 70px;
      left: 0;

      width: 100%;

      display: none;
      flex-direction: column;
      align-items: stretch;

      gap: 0;

      max-height: calc(100dvh - 70px);
      overflow-y: auto;

      padding: 12px 16px max(18px, env(safe-area-inset-bottom));

      border-bottom: 1px solid rgba(96, 165, 250, 0.16);

      background: rgba(2, 6, 23, 0.985);

      box-shadow: 0 26px 60px rgba(2, 6, 23, 0.58);

      backdrop-filter: blur(14px);
    }

    .nav.open {
      display: flex;
    }

    .nav-link {
      min-height: 48px;
      display: flex;
      align-items: center;
      padding: 13px 10px;

      border-bottom: 1px solid rgba(96, 165, 250, 0.10);

      font-size: 12px;
    }

    .nav-link::after {
      display: none;
    }

    .contact-link {
      margin-top: 12px;

      min-height: 48px;
      display: grid;
      place-items: center;
      padding: 11px;

      text-align: center;
    }
  }
</style>
