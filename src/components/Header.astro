---
const base = import.meta.env.BASE_URL;

const currentPath = Astro.url.pathname;

const links = [
  { href: base, label: "Home" },
  { href: `${base}experience`, label: "Experience" },
  { href: `${base}projects`, label: "Projects" },
  { href: `${base}articles`, label: "Articles" },
  { href: `${base}education`, label: "Education" },
];

const isActive = (href: string) => {
  if (href === base) {
    return currentPath === base || currentPath === `${base}/`;
  }

  return currentPath.startsWith(href);
};
---

<header class="site-header">
  <div class="header-container">

    <a href={base} class="brand">
      <span>$</span>
      felipe@sre
    </a>

    <button
      class="menu-toggle"
      aria-label="Toggle navigation"
      aria-expanded="false"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav class="nav">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              "nav-link",
              { active: isActive(link.href) },
            ]}
          >
            {link.label}
          </a>
        ))
      }

      <a
        href={`${base}#contact`}
        class="contact-link"
      >
        Contact
      </a>
    </nav>

  </div>
</header>

<script>
  const menuToggle = document.querySelector(".menu-toggle");
  const nav = document.querySelector(".nav");

  menuToggle?.addEventListener("click", () => {
    const isOpen = nav?.classList.toggle("open");

    menuToggle.setAttribute(
      "aria-expanded",
      String(Boolean(isOpen))
    );
  });

  document.querySelectorAll(".nav a").forEach((link) => {
    link.addEventListener("click", () => {
      nav?.classList.remove("open");

      menuToggle?.setAttribute(
        "aria-expanded",
        "false"
      );
    });
  });
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;

    z-index: 1000;

    width: 100%;

    border-bottom: 1px solid rgba(40, 50, 53, 0.75);

    background: rgba(8, 11, 12, 0.82);

    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .header-container {
    width: min(1100px, calc(100% - 48px));
    height: 72px;

    margin: 0 auto;

    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    color: #d9ddde;

    font-family:
      "SFMono-Regular",
      Consolas,
      "Liberation Mono",
      Menlo,
      monospace;

    font-size: 15px;
    font-weight: 600;

    text-decoration: none;

    transition: color 0.2s ease;
  }

  .brand span {
    margin-right: 7px;

    color: #36d399;
  }

  .brand:hover {
    color: #36d399;
  }

  .nav {
    display: flex;
    align-items: center;

    gap: 26px;
  }

  .nav-link {
    position: relative;

    padding: 27px 0 25px;

    color: #899396;

    font-family:
      "SFMono-Regular",
      Consolas,
      "Liberation Mono",
      Menlo,
      monospace;

    font-size: 12px;

    text-decoration: none;

    transition: color 0.2s ease;
  }

  .nav-link::after {
    content: "";

    position: absolute;

    left: 0;
    bottom: 17px;

    width: 100%;
    height: 1px;

    background: #36d399;

    transform: scaleX(0);

    transform-origin: left;

    transition: transform 0.2s ease;
  }

  .nav-link:hover {
    color: #d9ddde;
  }

  .nav-link.active {
    color: #36d399;
  }

  .nav-link.active::after {
    transform: scaleX(1);
  }

  .contact-link {
    padding: 8px 13px;

    border: 1px solid rgba(54, 211, 153, 0.45);
    border-radius: 6px;

    color: #36d399;

    font-family:
      "SFMono-Regular",
      Consolas,
      "Liberation Mono",
      Menlo,
      monospace;

    font-size: 11px;

    text-decoration: none;

    transition:
      background 0.2s ease,
      border-color 0.2s ease;
  }

  .contact-link:hover {
    border-color: #36d399;

    background: rgba(54, 211, 153, 0.08);
  }

  .menu-toggle {
    display: none;

    padding: 6px;

    border: 0;

    background: transparent;

    cursor: pointer;
  }

  .menu-toggle span {
    width: 22px;
    height: 1px;

    display: block;

    margin: 5px 0;

    background: #c9cfd1;

    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  @media (max-width: 700px) {
    .header-container {
      width: min(100% - 32px, 1100px);
      height: 68px;
    }

    .menu-toggle {
      display: block;
    }

    .nav {
      position: absolute;

      top: 68px;
      left: 0;

      width: 100%;

      display: none;
      flex-direction: column;
      align-items: stretch;

      gap: 0;

      padding: 14px 16px 18px;

      border-bottom: 1px solid #283235;

      background: rgba(8, 11, 12, 0.97);

      backdrop-filter: blur(14px);
    }

    .nav.open {
      display: flex;
    }

    .nav-link {
      padding: 13px 10px;

      border-bottom: 1px solid rgba(40, 50, 53, 0.55);

      font-size: 12px;
    }

    .nav-link::after {
      display: none;
    }

    .contact-link {
      margin-top: 12px;

      padding: 11px;

      text-align: center;
    }
  }
</style>