  }

  .motion-topbar {
    height: 46px;
    display: flex;
    align-items: center;
    padding: 0 16px;
    border-bottom: 1px solid rgba(96, 165, 250, 0.11);
    background: rgba(15, 23, 42, 0.65);
  }

  .motion-frame .traffic-lights span {
    width: 8px;
    height: 8px;
  }

  .motion-title {
    margin-left: 16px;
    color: #64748b;
    font-family: "Geist Mono", monospace;
    font-size: 9px;
  }

  .live-badge {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #86efac;
    font-family: "Geist Mono", monospace;
    font-size: 8px;
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  .live-badge i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--fso-green);
    box-shadow: 0 0 10px rgba(54, 211, 153, 0.78);
    animation: live-blink 1.8s ease-in-out infinite;
  }

  .motion-stage {
    position: relative;
    width: 100%;
    height: auto;
    min-height: 0;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .stage-grid,
  .stage-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .stage-grid {
    opacity: 0.23;
    background-image:
      linear-gradient(rgba(96, 165, 250, 0.13) 1px, transparent 1px),
      linear-gradient(90deg, rgba(96, 165, 250, 0.13) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(circle at center, black, transparent 84%);
  }

  .stage-glow {
    left: 50%;
    top: 50%;
    width: 280px;
    height: 280px;
    inset: auto;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(37, 99, 235, 0.24), rgba(124, 58, 237, 0.08) 48%, transparent 72%);
    filter: blur(24px);
    transform: translate(-50%, -50%);
    animation: stage-breathe 5s ease-in-out infinite;
  }

  .topology-animation {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .data-path {
    fill: none;
    stroke: url(#topology-blue);
    stroke-width: 1.25;
    stroke-dasharray: 5 8;
    opacity: 0.4;
    animation: data-stream 5s linear infinite;
  }

  .path-two { animation-delay: -1s; }
  .path-three { animation-delay: -2s; }
  .path-four { animation-delay: -3s; }

  .globe-aura {
    fill: rgba(37, 99, 235, 0.035);
    stroke: rgba(96, 165, 250, 0.1);
    stroke-width: 1;
    transform-box: fill-box;
    transform-origin: center;
    animation: aura-pulse 4.5s ease-in-out infinite;
  }

  .globe-edge {
    fill: url(#core-fill);
    stroke: url(#topology-blue);
    stroke-width: 1.3;
    opacity: 0.9;
    filter: drop-shadow(0 0 18px rgba(59, 130, 246, 0.2));
  }

  .globe-spin {
    transform-box: fill-box;
    transform-origin: center;
    animation: globe-turn 16s linear infinite;
  }

  .globe-line {
    fill: none;
    stroke: rgba(125, 211, 252, 0.34);
    stroke-width: 1;
  }

  .globe-line-soft {
    stroke: rgba(167, 139, 250, 0.2);
  }

  .globe-pulse {
    fill: none;
    stroke: rgba(34, 211, 238, 0.34);
    stroke-width: 1;
    transform-box: fill-box;
    transform-origin: center;
    animation: topology-pulse 3.6s ease-out infinite;
  }

  .globe-pulse-two {
    stroke: rgba(167, 139, 250, 0.32);
    animation-delay: -1.8s;
  }

  .core-node polygon {
    fill: rgba(8, 20, 44, 0.92);
    stroke: url(#topology-blue);
    stroke-width: 1.4;
  }

  .core-node text {
    fill: #e0f2fe;
    font-family: "Geist Mono", monospace;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  .core-node .core-subtitle {
    fill: #64748b;
    font-size: 6px;
    letter-spacing: 0.24em;
  }

  .service-node {
    transform-box: fill-box;
    transform-origin: center;
    animation: service-float 5s ease-in-out infinite;
  }

  .service-node circle {
    fill: rgba(7, 16, 31, 0.94);
    stroke: rgba(96, 165, 250, 0.38);
    stroke-width: 1.2;
    filter: drop-shadow(0 10px 16px rgba(2, 6, 23, 0.46));
  }

  .service-node text {
