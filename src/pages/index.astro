---
import Header from "../components/Header.astro";
import CloudScene from "../components/CloudScene.astro";

const base = import.meta.env.BASE_URL;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content="Technical portfolio of Felipe Sales de Oliveira, Cloud, DevOps and SRE Consultant focused on AWS, Kubernetes, Infrastructure as Code, GitOps and observability."
    />

    <link rel="canonical" href="https://felipesalesdeoliveira.github.io/felipe-sales-technical-portfolio/" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Felipe Sales | Cloud, DevOps & SRE Consultant" />
    <meta property="og:description" content="AWS, Kubernetes, Infrastructure as Code, GitOps, observability and reliability engineering backed by hands-on technical cases." />
    <meta property="og:url" content="https://felipesalesdeoliveira.github.io/felipe-sales-technical-portfolio/" />

    <title>Felipe Sales | Cloud, DevOps & SRE Consultant</title>
  </head>

  <body>
    <Header />

    <main class="container">

      <!-- =========================
           HERO
      ========================== -->

      <section id="home" class="hero">
        <div class="hero-ambient" aria-hidden="true">
          <span class="orb orb-blue"></span>
          <span class="orb orb-violet"></span>
          <span class="hero-grid"></span>
          <span class="particle particle-one"></span>
          <span class="particle particle-two"></span>
          <span class="particle particle-three"></span>
          <span class="particle particle-four"></span>
        </div>

        <div class="hero-layout">
          <div class="hero-copy">
            <div class="eyebrow">
              <span class="pulse-dot"></span>
              Cloud · DevOps · Reliability Engineering
            </div>

            <p class="hero-command"><span>$</span> whoami</p>
            <h1>Felipe Sales<br /><span>de Oliveira</span></h1>
            <p class="role">Cloud, DevOps & SRE Consultant</p>
            <p class="bio">
              I design, automate and operate <strong>AWS</strong> and
              <strong>Kubernetes</strong> environments using Infrastructure as Code,
              CI/CD, GitOps and observability practices.
            </p>

            <div class="hero-actions">
              <a class="primary-action" href={`${base}projects`}>
                Explore technical cases <span>→</span>
              </a>
              <a class="secondary-action" href={`${base}documents/felipe-sales-devops-engineer-en.pdf`} download>
                Download résumé
              </a>
            </div>

            <div class="hero-links" aria-label="Professional profiles">
              <a href="https://www.linkedin.com/in/felipesalesdeoliveira/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
              <a href="https://github.com/felipesalesdeoliveira" target="_blank" rel="noopener noreferrer">GitHub</a>
              <a href="mailto:fesales.oliveira@gmail.com">Email</a>
            </div>
          </div>

          <div class="hero-visual" aria-label="Cloud engineering status visualization">
            <div class="motion-frame">
              <div class="motion-topbar">
                <div class="traffic-lights">
                  <span class="red"></span>
                  <span class="yellow"></span>
                  <span class="green"></span>
                </div>
                <span class="motion-title">cloud-topology.live</span>
                <span class="live-badge"><i></i> LIVE</span>
              </div>

              <div class="motion-stage">
                <CloudScene />
              </div>

              <div class="motion-footer">
                <div><strong>FSO TECHNICAL CLOUD</strong><span>Automate · Deploy · Observe</span></div>
                <span class="infinity-mark">∞</span>
              </div>
            </div>

            <a
              href="https://felipesalesdeoliveira.github.io/fso-cloud-consulting/"
              target="_blank"
              rel="noopener noreferrer"
              class="consulting-pill"
            >
              FSO Cloud Consulting <span>↗</span>
            </a>
          </div>
        </div>
      </section>


      <!-- =========================
           CORE SKILLS
      ========================== -->

      <section class="section">

        <div class="section-title">
          <span>#</span>
          <h2>Core Skills</h2>
        </div>

        <p class="core-skills-intro">
          Capabilities I apply across architecture, delivery and operations to build reliable cloud platforms.
        </p>

        <div class="skills-grid">

          <article class="skill-card">
            <div class="skill-card-head"><span class="skill-symbol">AWS</span><small>01</small></div>
            <h3>AWS Cloud Architecture</h3>
            <p>Secure, resilient cloud foundations designed for scale, availability and controlled delivery.</p>
            <div class="skill-tags"><span>VPC</span><span>IAM</span><span>CloudFront</span><span>Serverless</span></div>
          </article>

          <article class="skill-card">
            <div class="skill-card-head"><span class="skill-symbol">IaC</span><small>02</small></div>
            <h3>Infrastructure as Code & Automation</h3>
            <p>Repeatable infrastructure and operational workflows with reviewable, versioned automation.</p>
            <div class="skill-tags"><span>Terraform</span><span>Ansible</span><span>Bash</span></div>
          </article>

          <article class="skill-card">
            <div class="skill-card-head"><span class="skill-symbol">K8s</span><small>03</small></div>
            <h3>Kubernetes & Container Platforms</h3>
            <p>Container platforms focused on safe workloads, declarative configuration and operability.</p>
            <div class="skill-tags"><span>Docker</span><span>Helm</span><span>Argo CD</span></div>
          </article>

          <article class="skill-card">
            <div class="skill-card-head"><span class="skill-symbol">CI</span><small>04</small></div>
            <h3>CI/CD & GitOps</h3>
            <p>Automated software delivery with quality gates, traceability and Git-driven deployments.</p>
            <div class="skill-tags"><span>GitHub Actions</span><span>Jenkins</span><span>GitLab CI</span></div>
          </article>

          <article class="skill-card">
            <div class="skill-card-head"><span class="skill-symbol">SLO</span><small>05</small></div>
            <h3>Observability & Reliability Engineering</h3>
            <p>Metrics, logs and traces transformed into actionable signals for reliable services.</p>
            <div class="skill-tags"><span>Prometheus</span><span>Grafana</span><span>OpenTelemetry</span></div>
          </article>

          <article class="skill-card">
            <div class="skill-card-head"><span class="skill-symbol">RCA</span><small>06</small></div>
            <h3>Incident Response & Troubleshooting</h3>
            <p>Structured diagnosis, impact reduction and root-cause analysis across distributed systems.</p>
            <div class="skill-tags"><span>Linux</span><span>Networking</span><span>Runbooks</span></div>
          </article>

        </div>

      </section>


      <!-- =========================
           FEATURED PROJECTS
      ========================== -->

      <section class="section">

        <div class="section-title">
          <span>#</span>
          <h2>Featured Projects</h2>
        </div>

        <p class="section-intro">
          Technical cases showing architecture decisions, implementation status
          and evidence from hands-on AWS environments.
        </p>

        <div class="featured-projects-grid">

          <article class="featured-project-card">
            <div class="featured-project-meta">
              <span>AWS & CDN</span>
              <strong class="status-completed">Completed</strong>
            </div>
            <h3>Secure Frontend Delivery on AWS</h3>
            <p>
              React SPA delivered from a private S3 origin through CloudFront,
              with OAC, managed TLS, custom DNS and a validated routing fallback.
            </p>
            <ul>
              <li>Direct S3 access blocked with 403</li>
              <li>HTTP redirected to HTTPS</li>
              <li>SPA routes and CloudFront cache behavior validated</li>
            </ul>
            <a
              href="https://felipesalesdeoliveira.github.io/fso-cloud-consulting/en/projects/frontend-cdn-s3-tls-custom-domain/"
              target="_blank"
              rel="noopener noreferrer"
            >
              View technical case →
            </a>
          </article>

          <article class="featured-project-card">
            <div class="featured-project-meta">
              <span>AWS & Serverless</span>
              <strong class="status-progress">In Progress</strong>
            </div>
            <h3>Serverless Marketplace with Identity and Events</h3>
            <p>
              Evolution of the published SPA into an event-driven system with
              Cognito, API Gateway, Lambda, DynamoDB, S3, SQS and a DLQ.
            </p>
            <ul>
              <li>Authentication and protected APIs</li>
              <li>Persistent catalog and product images</li>
              <li>Asynchronous order processing with failure isolation</li>
            </ul>
            <a
              href="https://felipesalesdeoliveira.github.io/fso-cloud-consulting/en/projects/serverless-marketplace-identity-events/"
              target="_blank"
              rel="noopener noreferrer"
            >
              Follow implementation →
            </a>
          </article>

        </div>

        <a class="all-projects-link" href={`${base}projects`}>
          View all projects →
        </a>

      </section>


      <!-- =========================
           TECH STACK
      ========================== -->

      <section class="section">

        <div class="section-title">
          <span>#</span>
          <h2>Tech Stack</h2>
        </div>

        <div class="stack-command" aria-label="Technology stack status">
          <span>$</span> stack --load <i>//</i> <strong>ready</strong><b></b>
        </div>

        <div class="tech-groups">

          <!-- CLOUD -->

          <div class="tech-group">

            <h3 class="tech-group-title">
              Primary Cloud
            </h3>

            <div class="tech-grid">

              <article class="tech-card">
                <img
                  src={`${base}icons/aws.svg`}
                  alt="AWS"
                  class="aws-icon"
                />
                <span>AWS</span>
              </article>

            </div>

          </div>


          <!-- CONTAINERS & PLATFORM -->

          <div class="tech-group">

            <h3 class="tech-group-title">
              Containers & Platform
            </h3>

            <div class="tech-grid">

              <article class="tech-card">
                <img
                  src={`${base}icons/kubernetes.svg`}
                  alt="Kubernetes"
                />
                <span>Kubernetes</span>
              </article>

              <article class="tech-card">
                <img
                  src={`${base}icons/docker.svg`}
                  alt="Docker"
                />
                <span>Docker</span>
              </article>

              <article class="tech-card">
                <img
                  src={`${base}icons/helm.svg`}
                  alt="Helm"
                />
                <span>Helm</span>
              </article>

              <article class="tech-card">
                <img
                  src={`${base}icons/argocd.svg`}
                  alt="Argo CD"
                />
                <span>Argo CD</span>
              </article>

            </div>

          </div>


          <!-- INFRASTRUCTURE & AUTOMATION -->

          <div class="tech-group">

            <h3 class="tech-group-title">
              Infrastructure & Automation
            </h3>

            <div class="tech-grid">

              <article class="tech-card">
                <img
                  src={`${base}icons/terraform.svg`}
                  alt="Terraform"
                />
                <span>Terraform</span>
              </article>

              <article class="tech-card">
                <img
                  src={`${base}icons/linux.svg`}
                  alt="Linux"
                />
                <span>Linux</span>
              </article>

              <article class="tech-card">
                <img
                  src={`${base}icons/bash.svg`}
                  alt="Bash"
                />
                <span>Bash</span>
              </article>

            </div>

          </div>


          <!-- CI/CD & VERSION CONTROL -->

          <div class="tech-group">

            <h3 class="tech-group-title">
              CI/CD & Version Control
            </h3>

            <div class="tech-grid">

              <article class="tech-card">
                <img
                  src={`${base}icons/githubactions.svg`}
                  alt="GitHub Actions"
                />
                <span>GitHub Actions</span>
              </article>

              <article class="tech-card">
                <img
                  src={`${base}icons/jenkins.svg`}
                  alt="Jenkins"
                />
                <span>Jenkins</span>
              </article>

              <article class="tech-card">
                <img
                  src={`${base}icons/git.svg`}
                  alt="Git"
                />
                <span>Git</span>
              </article>

            </div>

          </div>


          <!-- OBSERVABILITY -->

          <div class="tech-group">

            <h3 class="tech-group-title">
              Observability
            </h3>

            <div class="tech-grid">

              <article class="tech-card">
                <img
                  src={`${base}icons/prometheus.svg`}
                  alt="Prometheus"
                />
                <span>Prometheus</span>
              </article>

              <article class="tech-card">
                <img
                  src={`${base}icons/grafana.svg`}
                  alt="Grafana"
                />
                <span>Grafana</span>
              </article>

              <article class="tech-card">
                <img
                  src={`${base}icons/loki.svg`}
                  alt="Loki"
                />
                <span>Loki</span>
              </article>

              <article class="tech-card">
                <img
                  src={`${base}icons/elastic.svg`}
                  alt="Elastic"
                />
                <span>Elastic</span>
              </article>

              <article class="tech-card">
                <img
                  src={`${base}icons/opentelemetry.svg`}
                  alt="OpenTelemetry"
                />
                <span>OpenTelemetry</span>
              </article>

            </div>

          </div>


          <!-- ADDITIONAL EXPERIENCE -->

          <div class="tech-group additional-stack">

            <h3 class="tech-group-title">
              Additional Experience
            </h3>

            <p class="tech-group-description">
              Tools and platforms used in previous projects, labs or supporting work.
            </p>

            <div class="tech-grid">

              <article class="tech-card">
                <img src={`${base}icons/azure.svg`} alt="Microsoft Azure" />
                <span>Azure</span>
              </article>

              <article class="tech-card">
                <img src={`${base}icons/gcp.svg`} alt="Google Cloud" />
                <span>Google Cloud</span>
              </article>

              <article class="tech-card">
                <img src={`${base}icons/oci.svg`} alt="Oracle Cloud Infrastructure" />
                <span>OCI</span>
              </article>

              <article class="tech-card">
                <img src={`${base}icons/ansible.svg`} alt="Ansible" />
                <span>Ansible</span>
              </article>

              <article class="tech-card">
                <img src={`${base}icons/azuredevops.svg`} alt="Azure DevOps" />
                <span>Azure DevOps</span>
              </article>

              <article class="tech-card">
                <img src={`${base}icons/gitlab.svg`} alt="GitLab CI" />
                <span>GitLab CI</span>
              </article>

              <article class="tech-card">
                <img src={`${base}icons/opensearch.svg`} alt="OpenSearch" />
                <span>OpenSearch</span>
              </article>

              <article class="tech-card">
                <img src={`${base}icons/datadog.svg`} alt="Datadog" />
                <span>Datadog</span>
              </article>

              <article class="tech-card">
                <img src={`${base}icons/dynatrace.svg`} alt="Dynatrace" />
                <span>Dynatrace</span>
              </article>

            </div>

          </div>

        </div>

      </section>


      <!-- =========================
           CERTIFICATIONS
      ========================== -->

      <section class="section">

        <div class="section-title">
          <span>#</span>
          <h2>Certifications</h2>
        </div>

        <p class="certifications-intro">
          Validated foundations that support my hands-on work across cloud,
          Linux systems and data platforms.
        </p>

        <div class="certifications-grid">

          <!-- AWS -->

          <article class="cert-card">

            <div class="cert-card-head">
              <span class="cert-code">CERT-01</span>
              <span class="cert-signal"><i></i> PROFILE RECORD</span>
            </div>

            <div class="cert-icon">
              <img
                src={`${base}icons/aws.svg`}
                alt="AWS"
                class="aws-cert-icon"
              />
            </div>

            <div class="cert-content">

              <span class="cert-issuer">
                Amazon Web Services
              </span>

              <h3>
                AWS Certified Cloud Practitioner
              </h3>

              <span class="cert-status">Listed on LinkedIn</span>

            </div>

          </article>


          <!-- LINUX -->

          <article class="cert-card">

            <div class="cert-card-head">
              <span class="cert-code">CERT-02</span>
              <span class="cert-signal"><i></i> PROFILE RECORD</span>
            </div>

            <div class="cert-icon">
              <img
                src={`${base}icons/linux.svg`}
                alt="Linux"
              />
            </div>

            <div class="cert-content">

              <span class="cert-issuer">
                Linux
              </span>

              <h3>
                Linux Essentials
              </h3>

              <span class="cert-status">Listed on LinkedIn</span>

            </div>

          </article>


          <!-- DATABRICKS -->

          <article class="cert-card">

            <div class="cert-card-head">
              <span class="cert-code">CERT-03</span>
              <span class="cert-signal cert-signal--verified"><i></i> VERIFIED</span>
            </div>

            <div class="cert-icon">
              <img
                src={`${base}icons/databricks.svg`}
                alt="Databricks"
              />
            </div>

            <div class="cert-content">

              <span class="cert-issuer">
                Databricks
              </span>

              <h3>
                Databricks Fundamentals
              </h3>

              <a
                href="https://credentials.databricks.com/7d4846ec-1baa-41c8-a588-252185d672ae#acc.BC5ZtD3o"
                target="_blank"
                rel="noopener noreferrer"
              >
                View credential →
              </a>

            </div>

          </article>

        </div>

      </section>


      <!-- =========================
           CONTACT
      ========================== -->

      <section
        id="contact"
        class="section"
      >

        <div class="section-title">
          <span>#</span>
          <h2>Contact</h2>
        </div>

        <div class="contact-block">

          <div class="contact-window-bar">
            <div class="window-dots" aria-hidden="true"><i></i><i></i><i></i></div>
            <span>connect.fso</span>
            <span class="contact-availability"><i></i> AVAILABLE</span>
          </div>

          <div class="contact-layout">

            <div class="contact-copy">
              <p class="contact-command"><span>$</span> ./connect.sh --open</p>

              <h3>Let's engineer reliable systems.</h3>

              <p class="contact-text">
                For DevOps and SRE opportunities, technical collaboration or
                consulting engagements involving AWS, Kubernetes, automation and
                observability, choose the channel that best fits the conversation.
              </p>

              <div class="contact-email">
                <span>PRIMARY_CHANNEL</span>
                <a href="mailto:fesales.oliveira@gmail.com">fesales.oliveira@gmail.com</a>
              </div>

              <div class="contact-focus" aria-label="Professional focus">
                <span>AWS</span><span>KUBERNETES</span><span>SRE</span><span>AUTOMATION</span>
              </div>
            </div>

            <nav class="contact-links" aria-label="Contact channels">

            <a
              href="https://www.linkedin.com/in/felipesalesdeoliveira/"
              target="_blank"
              rel="noopener noreferrer"
            >
                <span class="contact-link-icon">in</span>
                <span><strong>LinkedIn</strong><small>Professional profile</small></span>
                <b>↗</b>
            </a>

            <a
              href="https://github.com/felipesalesdeoliveira"
              target="_blank"
              rel="noopener noreferrer"
            >
                <span class="contact-link-icon">gh</span>
                <span><strong>GitHub</strong><small>Code & infrastructure</small></span>
                <b>↗</b>
            </a>

            <a href="mailto:fesales.oliveira@gmail.com">
                <span class="contact-link-icon">@</span>
                <span><strong>Email</strong><small>Start a conversation</small></span>
                <b>→</b>
            </a>

            <a href={`${base}documents/felipe-sales-devops-engineer-en.pdf`} download>
                <span class="contact-link-icon">cv</span>
                <span><strong>Résumé</strong><small>Download PDF</small></span>
                <b>↓</b>
            </a>

            <a
              href="https://felipesalesdeoliveira.github.io/fso-cloud-consulting/"
              target="_blank"
              rel="noopener noreferrer"
            >
                <span class="contact-link-icon">fso</span>
                <span><strong>Consulting</strong><small>FSO Cloud Consulting</small></span>
                <b>↗</b>
            </a>

            </nav>

          </div>

        </div>

      </section>

    </main>
  </body>
</html>


<style>

  /* =========================
     GLOBAL
  ========================== */

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
    background: #080b0c;
  }

  :global(body) {
    margin: 0;
    min-height: 100vh;

    background:
      radial-gradient(
        circle at top right,
        rgba(54, 211, 153, 0.045),
        transparent 32%
      ),
      #080b0c;

    color: #e5e7e8;

    font-family:
      "SFMono-Regular",
      Consolas,
      "Liberation Mono",
      Menlo,
      monospace;
  }


  /* =========================
     CONTAINER
  ========================== */

  .container {
    width: min(1100px, calc(100% - 48px));
    margin: 0 auto;
  }


  /* =========================
     HERO
  ========================== */

  .hero {
    min-height: 100vh;

    display: flex;
    align-items: center;

    padding: 130px 0 90px;
  }


  /* =========================
     TERMINAL WINDOW
  ========================== */

  .terminal-window {
    width: 100%;
    max-width: 920px;

    margin: 0 auto;

    overflow: hidden;

    border: 1px solid #293332;
    border-radius: 14px;

    background: #090d0f;

    box-shadow:
      0 25px 70px rgba(0, 0, 0, 0.45),
      0 0 50px rgba(54, 211, 153, 0.035);
  }

  .terminal-header {
    height: 58px;

    display: flex;
    align-items: center;

    padding: 0 22px;

    border-bottom: 1px solid #293332;

    background: #171d20;
  }

  .traffic-lights {
    display: flex;
    gap: 9px;
  }

  .traffic-lights span {
    width: 13px;
    height: 13px;

    display: block;

    border-radius: 50%;
  }

  .red {
    background: #ff5f57;
  }

  .yellow {
    background: #febc2e;
  }

  .green {
    background: #28c840;
  }

  .terminal-title {
    margin-left: 25px;

    color: #7f898c;

    font-size: 14px;
  }

  .terminal-content {
    padding: 42px 42px 48px;
  }

  .command {
    margin: 0 0 17px;

    color: #8a9498;

    font-size: 16px;
  }

  .command span {
    margin-right: 14px;

    color: #36d399;
  }


  /* =========================
     NAME
  ========================== */

  h1 {
    margin: 0 0 40px;

    color: #36d399;

    font-size: clamp(38px, 6vw, 62px);

    line-height: 1;

    letter-spacing: -2px;
  }


  /* =========================
     ROLE
  ========================== */

  .role {
    margin: 0 0 38px;

    color: #5ca8ff;

    font-size: clamp(20px, 3vw, 28px);
  }

  .role strong {
    color: #667174;

    font-weight: normal;
  }


  /* =========================
     BIO
  ========================== */

  .bio {
    max-width: 760px;

    margin: 0;

    color: #c6cbcd;

    font-family:
      Inter,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    font-size: clamp(17px, 2vw, 20px);

    line-height: 1.7;
  }

  .bio strong {
    color: #36d399;
  }


  /* =========================
     HERO LINKS
  ========================== */

  .connect {
    margin-top: 42px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;

    gap: 14px;
  }

  .links a {
    padding: 11px 18px;

    border: 1px solid #303a3d;
    border-radius: 7px;

    background: #12181b;

    color: #c9cfd1;

    text-decoration: none;

    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease,
      background 0.2s ease;
  }

  .links a:hover {
    transform: translateY(-2px);

    border-color: #36d399;

    background: #101b18;

    color: #36d399;
  }


  /* =========================
     CONSULTING
  ========================== */

  .consulting-link {
    margin-top: 26px;

    display: flex;
    flex-direction: column;
    align-items: flex-start;

    gap: 12px;
  }

  .consulting-label {
    color: #8a9498;

    font-size: 13px;
  }

  .consulting-button {
    display: inline-flex;
    align-items: center;

    gap: 10px;

    padding: 11px 16px;

    border: 1px solid rgba(54, 211, 153, 0.45);
    border-radius: 7px;

    background: rgba(54, 211, 153, 0.06);

    color: #36d399;

    font-size: 12px;
    font-weight: 600;

    text-decoration: none;

    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .consulting-button span {
    transition: transform 0.2s ease;
  }

  .consulting-button:hover {
    transform: translateY(-2px);

    border-color: #36d399;

    background: rgba(54, 211, 153, 0.11);
  }

  .consulting-button:hover span {
    transform: translateX(3px);
  }


  /* =========================
     SECTIONS
  ========================== */

  .section {
    padding: 70px 0;
  }

  .section-title {
    display: flex;
    align-items: center;

    gap: 18px;

    padding-bottom: 20px;

    border-bottom: 1px solid #252d30;
  }

  .section-title span {
    color: #36d399;

    font-size: 30px;
    font-weight: 700;
  }

  .section-title h2 {
    margin: 0;

    color: #8d969a;

    font-size: clamp(26px, 3vw, 34px);

    letter-spacing: -1px;
  }


  /* =========================
     CORE SKILLS
  ========================== */

  .skills-grid {
    display: grid;

    grid-template-columns:
      repeat(3, minmax(0, 1fr));

    gap: 16px;

    margin-top: 32px;
  }

  .skill-card {
    min-height: 105px;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 20px;

    border: 1px solid #283235;
    border-radius: 9px;

    background: #0d1214;

    text-align: center;

    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .skill-card:hover {
    transform: translateY(-3px);

    border-color: #36d399;

    background: #0f1716;
  }

  .skill-card h3 {
    margin: 0;

    color: #d9ddde;

    font-family:
      Inter,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    font-size: 17px;
    font-weight: 500;

    line-height: 1.4;
  }

  .section-intro {
    max-width: 760px;
    margin: 28px 0 0;
    color: #8d969a;
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 16px;
    line-height: 1.7;
  }

  .featured-projects-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin-top: 28px;
  }

  .featured-project-card {
    display: flex;
    flex-direction: column;
    padding: 28px;
    border: 1px solid #283235;
    border-radius: 10px;
    background: #0d1214;
    transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .featured-project-card:hover {
    transform: translateY(-3px);
    border-color: #36d399;
    background: #0f1716;
  }

  .featured-project-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: #36d399;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.7px;
  }

  .featured-project-meta strong {
    padding: 5px 9px;
    border: 1px solid #293437;
    border-radius: 6px;
    font-size: 10px;
    font-weight: 500;
  }

  .status-completed {
    color: #36d399;
  }

  .status-progress {
    color: #f0b75b;
  }

  .featured-project-card h3 {
    margin: 24px 0 0;
    color: #e0e4e5;
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 23px;
    line-height: 1.35;
  }

  .featured-project-card p,
  .featured-project-card li {
    color: #9ba4a7;
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 14px;
    line-height: 1.7;
  }

  .featured-project-card ul {
    margin: 18px 0 24px;
    padding-left: 20px;
  }

  .featured-project-card a,
  .all-projects-link {
    color: #36d399;
    font-size: 13px;
    text-decoration: none;
  }

  .featured-project-card a {
    margin-top: auto;
  }

  .all-projects-link {
    display: inline-block;
    margin-top: 24px;
  }


  /* =========================
     TECH STACK
  ========================== */

  .tech-groups {
    display: flex;
    flex-direction: column;

    gap: 34px;

    margin-top: 30px;
  }

  .tech-group-title {
    margin: 0 0 14px;

    color: #7f898c;

    font-size: 13px;
    font-weight: 500;

    text-transform: uppercase;

    letter-spacing: 1px;
  }

  .tech-group-description {
    max-width: 680px;
    margin: -4px 0 16px;
    color: #667174;
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 13px;
    line-height: 1.6;
  }

  .additional-stack {
    padding-top: 28px;
    border-top: 1px solid #252d30;
  }

  .additional-stack .tech-card {
    min-height: 92px;
    opacity: 0.78;
  }

  .tech-grid {
    display: grid;

    grid-template-columns:
      repeat(4, minmax(0, 1fr));

    gap: 12px;
  }

  .tech-card {
    min-height: 105px;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    gap: 10px;

    padding: 16px 12px;

    border: 1px solid #283235;
    border-radius: 9px;

    background: #0d1214;

    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .tech-card:hover {
    transform: translateY(-3px);

    border-color: #36d399;

    background: #0f1716;
  }

  .tech-card img {
    width: 34px;
    height: 34px;

    object-fit: contain;

    opacity: 0.9;

    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .tech-card img.aws-icon {
    width: 44px;
    height: 44px;
  }

  .tech-card:hover img {
    opacity: 1;

    transform: scale(1.08);
  }

  .tech-card span {
    color: #cfd4d5;

    font-family:
      Inter,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    font-size: 13px;
    font-weight: 500;

    text-align: center;
  }


  /* =========================
     CERTIFICATIONS
  ========================== */

  .certifications-grid {
    display: grid;

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: 14px;

    margin-top: 28px;
  }

  .cert-card {
    min-height: 145px;

    display: flex;
    align-items: center;

    gap: 20px;

    padding: 22px;

    border: 1px solid #283235;
    border-radius: 9px;

    background: #0d1214;

    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .cert-card:hover {
    transform: translateY(-3px);

    border-color: #36d399;

    background: #0f1716;
  }

  .cert-icon {
    width: 56px;
    height: 56px;

    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 1px solid #293437;
    border-radius: 10px;

    background: #111719;
  }

  .cert-icon img {
    width: 32px;
    height: 32px;

    object-fit: contain;
  }

  .cert-icon img.aws-cert-icon {
    width: 40px;
    height: 40px;
  }

  .cert-content {
    min-width: 0;

    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .cert-issuer {
    margin-bottom: 6px;

    color: #667174;

    font-size: 11px;
    font-weight: 500;

    text-transform: uppercase;

    letter-spacing: 0.6px;
  }

  .cert-content h3 {
    margin: 0 0 12px;

    color: #d9ddde;

    font-family:
      Inter,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    font-size: 16px;
    font-weight: 500;

    line-height: 1.4;
  }

  .cert-content a {
    color: #36d399;

    font-size: 12px;

    text-decoration: none;

    transition: opacity 0.2s ease;
  }

  .cert-content a:hover {
    opacity: 0.7;
  }

  .cert-status {
    color: #667174;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }


  /* =========================
     CONTACT
  ========================== */

  .contact-block {
    margin-top: 28px;

    padding: 26px;

    border: 1px solid #283235;
    border-radius: 10px;

    background: #0d1214;
  }

  .contact-command {
    margin: 0 0 18px;

    color: #36d399;

    font-size: 15px;
  }

  .contact-text {
    max-width: 680px;

    margin: 0;

    color: #aeb5b7;

    font-family:
      Inter,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    font-size: 16px;

    line-height: 1.7;
  }

  .contact-email {
    margin: 18px 0 0;

    color: #36d399;

    font-size: 14px;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;

    gap: 12px;

    margin-top: 26px;
  }

  .contact-links a {
    min-width: 110px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 11px 18px;

    border: 1px solid #303a3d;
    border-radius: 7px;

    background: #12181b;

    color: #c9cfd1;

    font-size: 13px;

    text-decoration: none;

    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease,
      transform 0.2s ease;
  }

  .contact-links a:hover {
    transform: translateY(-2px);

    border-color: #36d399;

    background: #101b18;

    color: #36d399;
  }


  /* =========================
     TABLET
  ========================== */

  @media (max-width: 900px) {

    .skills-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }

    .tech-grid {
      grid-template-columns:
        repeat(3, minmax(0, 1fr));
    }

    .featured-projects-grid {
      grid-template-columns: 1fr;
    }

  }


  /* =========================
     MOBILE
  ========================== */

  @media (max-width: 700px) {

    .container {
      width: min(100% - 32px, 1100px);
    }

    .hero {
      min-height: auto;

      padding: 120px 0 70px;
    }

    .terminal-content {
      padding: 32px 24px 36px;
    }

    .terminal-header {
      padding: 0 18px;
    }

    .terminal-title {
      margin-left: 18px;
    }

    h1 {
      margin-bottom: 32px;
    }

    .role {
      margin-bottom: 32px;
    }

    .section {
      padding: 55px 0;
    }

    .section-title {
      gap: 12px;
    }

    .section-title span {
      font-size: 25px;
    }


    /* CERTIFICATIONS */

    .certifications-grid {
      grid-template-columns: 1fr;

      gap: 12px;
    }

    .cert-card {
      min-height: auto;

      padding: 18px;

      gap: 15px;
    }

    .cert-icon {
      width: 48px;
      height: 48px;
    }

    .cert-icon img {
      width: 27px;
      height: 27px;
    }

    .cert-icon img.aws-cert-icon {
      width: 34px;
      height: 34px;
    }

    .cert-content h3 {
      font-size: 15px;

      line-height: 1.35;
    }

    .cert-issuer {
      font-size: 10px;
    }

    .cert-content a {
      font-size: 11px;
    }

  }


  /* =========================
     SMALL MOBILE
  ========================== */

  @media (max-width: 600px) {

    /* HERO */

    .terminal-window {
      border-radius: 10px;
    }

    .terminal-header {
      height: 52px;
    }

    .traffic-lights span {
      width: 11px;
      height: 11px;
    }

    .terminal-title {
      font-size: 12px;
    }

    .terminal-content {
      padding: 28px 24px 40px;
    }

    .command {
      margin-bottom: 14px;

      font-size: 14px;
    }

    .command span {
      margin-right: 10px;
    }

    h1 {
      margin-bottom: 28px;

      font-size: 32px;

      line-height: 1.08;

      letter-spacing: -1.4px;
    }

    .role {
      margin-bottom: 30px;

      font-size: 20px;

      line-height: 1.35;
    }

    .bio {
      font-size: 16px;

      line-height: 1.65;
    }

    .connect {
      margin-top: 32px;
    }

    .links {
      gap: 10px;
    }

    .links a {
      padding: 10px 14px;

      font-size: 12px;
    }


    /* CONSULTING */

    .consulting-link {
      margin-top: 22px;
    }

    .consulting-label {
      font-size: 12px;
    }

    .consulting-button {
      padding: 10px 14px;

      font-size: 11px;
    }


    /* CORE SKILLS */

    .skills-grid {
      grid-template-columns: 1fr;

      gap: 10px;
    }

    .skill-card {
      min-height: 76px;

      padding: 16px 14px;
    }

    .skill-card h3 {
      font-size: 15px;

      line-height: 1.3;
    }


    /* TECH STACK */

    .tech-groups {
      gap: 28px;

      margin-top: 26px;
    }

    .tech-group-title {
      margin-bottom: 11px;

      font-size: 11px;
    }

    .tech-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));

      gap: 10px;
    }

    .tech-card {
      min-height: 88px;

      padding: 12px 10px;

      gap: 8px;
    }

    .tech-card img {
      width: 28px;
      height: 28px;
    }

    .tech-card img.aws-icon {
      width: 38px;
      height: 38px;
    }

    .tech-card span {
      font-size: 12px;

      line-height: 1.3;
    }


    /* CONTACT */

    .contact-block {
      padding: 18px;
    }

    .contact-text {
      font-size: 14px;

      line-height: 1.6;
    }

    .contact-email {
      font-size: 13px;

      overflow-wrap: anywhere;
    }

    .contact-links {
      flex-direction: column;

      gap: 10px;
    }

    .contact-links a {
      width: 100%;

      padding: 10px 14px;

      font-size: 12px;
    }

  }

  /* =========================================================
     FSO TECHNICAL DARK — REDESIGN PREVIEW
  ========================================================= */

  :global(:root) {
    --fso-bg: #020617;
    --fso-surface: rgba(7, 16, 31, 0.78);
    --fso-surface-strong: #07101f;
    --fso-border: rgba(96, 165, 250, 0.16);
    --fso-blue: #3b82f6;
    --fso-cyan: #22d3ee;
    --fso-violet: #8b5cf6;
    --fso-green: #36d399;
    --fso-text: #f1f5f9;
    --fso-muted: #94a3b8;
  }

  :global(html) {
    background: var(--fso-bg);
  }

  :global(body) {
    overflow-x: hidden;
    background:
      radial-gradient(circle at 8% 12%, rgba(37, 99, 235, 0.13), transparent 28%),
      radial-gradient(circle at 92% 35%, rgba(139, 92, 246, 0.10), transparent 30%),
      var(--fso-bg);
    color: var(--fso-text);
    font-family: "Geist", Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .container {
    width: min(1320px, calc(100% - 48px));
  }

  .hero {
    position: relative;
    min-height: 100svh;
    padding: 128px 0 88px;
    isolation: isolate;
  }

  .hero-layout {
    position: relative;
    z-index: 2;
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(540px, 1.08fr);
    align-items: center;
    gap: clamp(42px, 5vw, 72px);
  }

  .hero-ambient,
  .hero-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-grid {
    opacity: 0.24;
    background-image:
      linear-gradient(rgba(96, 165, 250, 0.12) 1px, transparent 1px),
      linear-gradient(90deg, rgba(96, 165, 250, 0.12) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: linear-gradient(to bottom, transparent, black 20%, black 68%, transparent 96%);
  }

  .orb {
    position: absolute;
    border-radius: 999px;
    filter: blur(110px);
    opacity: 0.22;
    animation: orb-drift 12s ease-in-out infinite alternate;
  }

  .orb-blue {
    width: 460px;
    height: 460px;
    top: 6%;
    right: 12%;
    background: #2563eb;
  }

  .orb-violet {
    width: 360px;
    height: 360px;
    right: -9%;
    bottom: 8%;
    background: #7c3aed;
    animation-delay: -5s;
  }

  .particle {
    position: absolute;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--fso-cyan);
    box-shadow: 0 0 18px 4px rgba(34, 211, 238, 0.5);
    animation: particle-float 7s ease-in-out infinite;
  }

  .particle-one { left: 7%; top: 24%; }
  .particle-two { left: 44%; top: 16%; animation-delay: -2s; }
  .particle-three { right: 7%; top: 31%; animation-delay: -4s; }
  .particle-four { right: 35%; bottom: 13%; animation-delay: -6s; }

  .hero-copy {
    position: relative;
    z-index: 4;
  }

  .eyebrow {
    width: fit-content;
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 30px;
    padding: 8px 13px;
    border: 1px solid rgba(96, 165, 250, 0.22);
    border-radius: 999px;
    background: rgba(15, 23, 42, 0.65);
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.035);
    color: #cbd5e1;
    font-family: "Geist Mono", monospace;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    backdrop-filter: blur(16px);
  }

  .pulse-dot {
    width: 7px;
    height: 7px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--fso-blue);
    box-shadow: 0 0 0 0 rgba(59, 130, 246, 0.6);
    animation: pulse 2.4s infinite;
  }

  .hero-command {
    margin: 0 0 15px;
    color: var(--fso-muted);
    font-family: "Geist Mono", monospace;
    font-size: 13px;
  }

  .hero-command span {
    margin-right: 9px;
    color: var(--fso-cyan);
  }

  .hero h1 {
    margin: 0;
    color: var(--fso-text);
    font-family: "Geist", sans-serif;
    font-size: clamp(48px, 6vw, 72px);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .hero h1 span {
    color: transparent;
    background: linear-gradient(105deg, #60a5fa 5%, #22d3ee 48%, #a78bfa 96%);
    background-clip: text;
    -webkit-background-clip: text;
  }

  .hero .role {
    margin: 28px 0 0;
    color: #dbeafe;
    font-family: "Geist", sans-serif;
    font-size: clamp(19px, 2.2vw, 25px);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .hero .bio {
    max-width: 620px;
    margin: 22px 0 0;
    color: #94a3b8;
    font-family: "Geist", sans-serif;
    font-size: 17px;
    line-height: 1.72;
  }

  .hero .bio strong {
    color: #e2e8f0;
    font-weight: 600;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 13px;
    margin-top: 34px;
  }

  .hero-actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 48px;
    padding: 0 20px;
    border-radius: 11px;
    color: white;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .primary-action {
    border: 1px solid rgba(56, 189, 248, 0.42);
    background: linear-gradient(105deg, #087af5, #2563eb 68%, #0ea5e9);
    box-shadow: 0 14px 36px rgba(8, 122, 245, 0.27), inset 0 1px rgba(255, 255, 255, 0.16);
  }

  .secondary-action {
    border: 1px solid rgba(96, 165, 250, 0.28);
    background: linear-gradient(145deg, rgba(15, 28, 52, 0.82), rgba(7, 15, 31, 0.8));
