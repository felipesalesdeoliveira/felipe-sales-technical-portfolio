    font-family: "Geist Mono", monospace;
    font-size: 10px;
    font-weight: 600;
  }

  .node-k8s { animation-delay: -1.25s; }
  .node-iac { animation-delay: -2.5s; }
  .node-otel { animation-delay: -3.75s; }

  .packet {
