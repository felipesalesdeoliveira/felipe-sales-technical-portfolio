---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Experience | Felipe Sales"
  description="Professional experience of Felipe Sales in DevOps, SRE, Cloud and Observability."
>
  <section class="page">

    <p class="page-command">$ cat experience.log</p>

    <h1>Experience</h1>

    <p class="page-description">
      My professional journey across Site Reliability Engineering,
      DevOps, cloud infrastructure, observability and automation.
    </p>

    <div class="timeline">

      <!-- FSO CLOUD CONSULTING -->
      <article class="experience-item">

        <div class="timeline-marker"></div>

        <div class="experience-card">

          <div class="experience-header">
            <div>
              <span class="experience-period">
                Jan 2025 — Present
              </span>

              <h2>Cloud, DevOps & SRE Consultant</h2>

              <p class="company">
                FSO Cloud Consulting
              </p>
            </div>

            <span class="location">
              Florianópolis, SC, Brazil
            </span>
          </div>

          <p class="experience-description">
            Independent consulting in Cloud, DevOps and Site Reliability
            Engineering, focused on AWS architecture, infrastructure
            automation, CI/CD, observability and cloud-native operations.
          </p>

          <ul>
            <li>
              Design and evolve AWS architectures with availability,
              scalability, security, networking and cost in mind.
            </li>

            <li>
              Automate infrastructure provisioning with Terraform and
              Infrastructure as Code practices.
            </li>

            <li>
              Build and operate containerized environments using Kubernetes,
              Amazon EKS, Docker and Helm.
            </li>

            <li>
              Implement and improve CI/CD and GitOps workflows for more
              automated and consistent build and deployment processes.
            </li>

            <li>
              Implement monitoring and observability with synthetic checks,
              dashboards and alerts, and investigate failures using metrics,
              logs, APIs and availability data.
            </li>
          </ul>

          <div class="tags">
            <span>SRE</span>
            <span>Consulting</span>
            <span>AWS</span>
            <span>Observability</span>
            <span>Kubernetes</span>
            <span>Terraform</span>
            <span>CI/CD</span>
            <span>GitOps</span>
          </div>

        </div>
      </article>


      <!-- TECHNICAL PROJECTS -->
      <article class="experience-item">

        <div class="timeline-marker"></div>

        <div class="experience-card">

          <div class="experience-header">
            <div>
              <span class="experience-period">
                Jan 2025 — Dec 2025
              </span>

              <h2>DevOps & SRE — Technical Projects</h2>

              <p class="company">
                FSO Cloud Consulting
              </p>
            </div>

            <span class="location">
              Florianópolis, SC, Brazil
            </span>
          </div>

          <p class="experience-description">
            Developed hands-on technical projects applying DevOps, SRE,
            cloud, Kubernetes, Infrastructure as Code, CI/CD, GitOps,
            observability and FinOps practices.
          </p>

          <ul>
            <li>
              Designed an end-to-end DevOps architecture on AWS with
              Terraform, Jenkins, Kubernetes, Argo CD, Prometheus and Grafana.
            </li>

            <li>
              Built a multi-cluster Kubernetes observability architecture
              with centralized metrics and logs on Amazon EKS.
            </li>

            <li>
              Implemented 360° Kubernetes observability by correlating
              metrics, logs and traces with OpenTelemetry and Tempo.
            </li>

            <li>
              Developed an AWS cost monitoring and optimization solution
              using Cost Explorer, AWS Budgets, Compute Optimizer and Lambda.
            </li>
          </ul>

          <div class="tags">
            <span>AWS</span>
            <span>Terraform</span>
            <span>Kubernetes</span>
            <span>Argo CD</span>
            <span>Prometheus</span>
            <span>OpenTelemetry</span>
            <span>FinOps</span>
          </div>

        </div>
      </article>


      <!-- FCAMARA -->
      <article class="experience-item">

        <div class="timeline-marker"></div>

        <div class="experience-card">

          <div class="experience-header">
            <div>
              <span class="experience-period">
                Jan 2023 — Dec 2024
              </span>

              <h2>DevOps Engineer</h2>

              <p class="company">
                FCamara
              </p>
            </div>

            <span class="location">
              Florianópolis, SC
            </span>
          </div>

          <p class="experience-description">
            Worked on the operation and evolution of cloud infrastructure
            and Kubernetes environments supporting production applications,
            with a focus on observability, reliability and platform support.
          </p>

          <ul>
            <li>
              Implemented and evolved an observability platform using
              Prometheus, Grafana, Loki and Elastic Stack.
            </li>

            <li>
              Supported production environments through troubleshooting,
              incident investigation and failure analysis.
            </li>

            <li>
              Automated AWS infrastructure provisioning with Terraform,
              including VPC, IAM, EC2, RDS, S3 and Amazon EKS.
            </li>

            <li>
              Structured and standardized CI/CD pipelines using GitHub
              Actions.
            </li>

            <li>
              Deployed and maintained containerized applications in
              Kubernetes using Helm.
            </li>
          </ul>

          <div class="tags">
            <span>AWS</span>
            <span>Kubernetes</span>
            <span>Terraform</span>
            <span>GitHub Actions</span>
            <span>Helm</span>
            <span>Prometheus</span>
            <span>Grafana</span>
          </div>

        </div>
      </article>


      <!-- CIVIL ENGINEERING -->
      <article class="experience-item">

        <div class="timeline-marker"></div>

        <div class="experience-card">

          <div class="experience-header">
            <div>
              <span class="experience-period">
                Feb 2020 — Jan 2023
              </span>

              <h2>Civil Engineer</h2>

              <p class="company">
                Cymaco Engenharia
              </p>
            </div>

            <span class="location">
              Florianópolis, SC, Brazil
            </span>
          </div>

          <p class="experience-description">
            Planned and monitored construction projects, with a focus on
            cost, schedule and resource control, as well as operational
            organization.
          </p>

          <p class="career-transition">
            Responsible for budgeting, financial analysis, schedule tracking
            and decision-making support. This experience strengthened my
            systems thinking, organization, risk analysis and problem-solving.
          </p>

        </div>
      </article>

    </div>

  </section>
</BaseLayout>


<style>
  .timeline {
    position: relative;

    margin-top: 50px;

    padding-left: 34px;
  }

  .timeline::before {
    content: "";

    position: absolute;

    top: 8px;
    bottom: 8px;
    left: 7px;

    width: 1px;

    background: #263134;
  }

  .experience-item {
    position: relative;

    margin-bottom: 34px;
  }

  .timeline-marker {
    position: absolute;

    top: 27px;
    left: -33px;

    width: 14px;
    height: 14px;

    border: 3px solid #080b0c;

    border-radius: 50%;

    background: #36d399;

    box-shadow:
      0 0 0 1px #36d399,
      0 0 18px rgba(54, 211, 153, 0.18);
  }

  .experience-card {
    padding: 30px;

    border: 1px solid #283235;
    border-radius: 10px;

    background: #0d1214;

    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .experience-card:hover {
    transform: translateY(-2px);

    border-color: #36d399;

    background: #0f1716;
  }

  .experience-header {
    display: flex;

    justify-content: space-between;
    align-items: flex-start;

    gap: 30px;

    padding-bottom: 22px;

    border-bottom: 1px solid #202a2c;
  }

  .experience-period {
    display: block;

    margin-bottom: 8px;

    color: #36d399;

    font-size: 12px;

    text-transform: uppercase;

    letter-spacing: 0.5px;
  }

  .experience-card h2 {
    margin: 0;

    color: #e0e4e5;

    font-family:
      Inter,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    font-size: 22px;

    font-weight: 600;
  }

  .company {
    margin: 7px 0 0;

    color: #5ca8ff;

    font-size: 14px;
  }

  .location {
    color: #677174;

    font-size: 12px;

    white-space: nowrap;
  }

  .experience-description,
  .career-transition {
    margin: 24px 0 0;

    color: #aeb5b7;

    font-family:
      Inter,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    font-size: 15px;

    line-height: 1.7;
  }

  .experience-card ul {
    margin: 22px 0 0;

    padding-left: 20px;

    color: #949da0;

    font-family:
      Inter,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    font-size: 14px;

    line-height: 1.7;
  }

  .experience-card li {
    margin-bottom: 9px;
  }

  .experience-card li::marker {
    color: #36d399;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;

    gap: 8px;

    margin-top: 25px;
  }

  .tags span {
    padding: 6px 10px;

    border: 1px solid #293437;
    border-radius: 6px;

    background: #111719;

    color: #7f898c;

    font-size: 11px;
  }

  @media (max-width: 700px) {

  .timeline {
    margin-top: 46px;
    padding-left: 18px;
  }

  .timeline::before {
    left: 5px;
  }

  .timeline-marker {
    left: -17px;
    top: 24px;

    width: 12px;
    height: 12px;
  }

  .experience-card {
    padding: 18px;
  }

  .experience-header {
    flex-direction: column;
    gap: 8px;
    padding-bottom: 18px;
  }

  .experience-card h2 {
    font-size: 19px;
    line-height: 1.3;
  }

  .company {
    font-size: 13px;
  }

  .location {
    font-size: 11px;
    white-space: normal;
  }

  .experience-description,
  .career-transition {
    margin-top: 20px;
    font-size: 14px;
    line-height: 1.65;
  }

  .experience-card ul {
    margin-top: 18px;
    padding-left: 18px;

    font-size: 13px;
    line-height: 1.65;
  }

  .experience-card li {
    margin-bottom: 8px;
    padding-left: 2px;
  }

  .tags {
    gap: 7px;
    margin-top: 20px;
  }

  .tags span {
    padding: 5px 8px;
    font-size: 10px;
  }

}
  
</style>
