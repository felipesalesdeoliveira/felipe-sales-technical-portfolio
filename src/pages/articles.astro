---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Articles | Felipe Sales"
  description="Technical articles by Felipe Sales about DevOps, SRE, Cloud, Kubernetes and Observability."
>
  <section class="page">

    <p class="page-command">$ ls ~/articles/</p>

    <h1>Articles</h1>

    <p class="page-description">
      Technical notes and articles about DevOps, Site Reliability Engineering,
      Kubernetes, Cloud and Observability.
    </p>

    <div class="articles-grid">

      <!-- ARTICLE 1 -->
      <article class="article-card">

        <div class="article-meta">
          <span class="article-category">AWS Architecture</span>
          <span class="article-status published">Published</span>
        </div>

        <h2>
          Secure SPA Delivery with S3, CloudFront and OAC
        </h2>

        <p class="article-description">
          The architecture decisions and validation steps behind a React SPA
          delivered through CloudFront while keeping its S3 origin private.
        </p>

        <div class="article-tags">
          <span>Amazon S3</span>
          <span>CloudFront</span>
          <span>OAC</span>
          <span>Route 53</span>
        </div>

        <a class="article-link" href={`${base}articles/secure-spa-delivery-aws`}>
          Read article →
        </a>

      </article>


      <!-- ARTICLE 2 -->
      <article class="article-card">

        <div class="article-meta">
          <span class="article-category">Observability</span>
          <span class="article-status">Coming Soon</span>
        </div>

        <h2>
          Kubernetes Observability: Metrics, Logs and Traces
        </h2>

        <p class="article-description">
          An introduction to the three pillars of observability and how
          Prometheus, Grafana, Loki and OpenTelemetry can work together
          in Kubernetes environments.
        </p>

        <div class="article-tags">
          <span>Prometheus</span>
          <span>Grafana</span>
          <span>Loki</span>
          <span>OpenTelemetry</span>
        </div>

      </article>


      <!-- ARTICLE 3 -->
      <article class="article-card">

        <div class="article-meta">
          <span class="article-category">AWS</span>
          <span class="article-status">Coming Soon</span>
        </div>

        <h2>
          Understanding an Amazon EKS Architecture
        </h2>

        <p class="article-description">
          A practical overview of the infrastructure behind Amazon EKS,
          including VPCs, subnets, load balancers, worker nodes, pods,
          networking and access flow.
        </p>

        <div class="article-tags">
          <span>AWS</span>
          <span>EKS</span>
          <span>Kubernetes</span>
          <span>Networking</span>
        </div>

      </article>

    </div>

  </section>
</BaseLayout>


<style>

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 20px;

    margin-top: 70px;
  }

  .article-card {
    min-height: 300px;

    display: flex;
    flex-direction: column;

    padding: 28px;

    border: 1px solid rgba(96, 165, 250, 0.16);
    border-radius: 10px;

    background: rgba(7, 16, 31, 0.78);

    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .article-card:hover {
    transform: translateY(-3px);

    border-color: #22d3ee;

    background: rgba(10, 20, 38, 0.94);
  }

  .article-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;

    gap: 16px;

    margin-bottom: 22px;
  }

  .article-category {
    color: #22d3ee;

    font-size: 11px;

    text-transform: uppercase;

    letter-spacing: 0.7px;
  }

  .article-status {
    padding: 5px 9px;

    border: 1px solid rgba(96, 165, 250, 0.18);
    border-radius: 6px;

    background: rgba(15, 23, 42, 0.72);

    color: #94a3b8;

    font-size: 10px;

    text-transform: uppercase;

    letter-spacing: 0.6px;
  }

  .article-status.published {
    color: #22d3ee;
    border-color: rgba(54, 211, 153, 0.35);
  }

  .article-card h2 {
    margin: 0;

    color: #f1f5f9;

    font-family:
      Inter,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    font-size: 22px;

    font-weight: 600;

    line-height: 1.35;
  }

  .article-description {
    margin: 18px 0 0;

    color: #94a3b8;

    font-family:
      Inter,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    font-size: 14px;

    line-height: 1.7;
  }

  .article-link {
    display: inline-block;
    margin-top: auto;
    padding-top: 24px;
    color: #22d3ee;
    font-size: 13px;
    text-decoration: none;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;

    gap: 8px;

    margin-top: auto;

    padding-top: 24px;
  }

  .article-tags span {
    padding: 6px 10px;

    border: 1px solid rgba(96, 165, 250, 0.18);
    border-radius: 6px;

    background: rgba(15, 23, 42, 0.72);

    color: #94a3b8;

    font-size: 11px;
  }

  @media (max-width: 900px) {

    .articles-grid {
      grid-template-columns: 1fr;
    }

  }

  @media (max-width: 700px) {

    .articles-grid {
      margin-top: 50px;
    }

    .article-card {
      min-height: auto;

      padding: 22px;
    }

    .article-meta {
      align-items: flex-start;
    }

    .article-card h2 {
      font-size: 20px;
    }

  }

</style>
