---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Education | Felipe Sales"
  description="Academic background and professional development of Felipe Sales."
>
  <section class="page">

    <p class="page-command">$ cat education.txt</p>

    <h1>Education</h1>

    <p class="page-description">
      Academic background combining technology, engineering and continuous
      professional development.
    </p>

    <div class="education-list">

      <!-- COMPUTER SCIENCE -->
      <article class="education-card">

        <div class="education-period">
          2026 — 2029
        </div>

        <div class="education-content">

          <span class="education-status">
            In Progress
          </span>

          <h2>
            Bachelor's Degree in Computer Science
          </h2>

          <p class="institution">
            Universidade do Sul de Santa Catarina — Unisul
          </p>

          <p class="education-description">
            Undergraduate studies focused on computer science fundamentals,
            software development, algorithms and computing technologies.
          </p>

        </div>

      </article>


      <!-- CIVIL ENGINEERING -->
      <article class="education-card">

        <div class="education-period">
          2012 — 2017
        </div>

        <div class="education-content">

          <h2>
            Bachelor's Degree in Civil Engineering
          </h2>

          <p class="institution">
            Universidade do Sul de Santa Catarina — Unisul
          </p>

          <p class="education-description">
            Engineering background that strengthened analytical thinking,
            planning, problem solving, risk analysis and systems thinking.
          </p>

        </div>

      </article>


      <!-- TECHNICAL DEGREE -->
      <article class="education-card">

        <div class="education-period">
          2010 — 2011
        </div>

        <div class="education-content">

          <h2>
            Technical Degree in Building Construction
          </h2>

          <p class="institution">
            Instituto Federal de Santa Catarina — IFSC
          </p>

        </div>

      </article>

    </div>

  </section>
</BaseLayout>


<style>

  .education-list {
    display: flex;
    flex-direction: column;

    gap: 20px;

    margin-top: 70px;
  }

  .education-card {
    display: grid;

    grid-template-columns: 150px 1fr;

    border: 1px solid #283235;
    border-radius: 10px;

    overflow: hidden;

    background: #0d1214;

    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .education-card:hover {
    transform: translateY(-2px);

    border-color: #36d399;

    background: #0f1716;
  }

  .education-period {
    display: flex;
    align-items: flex-start;
    justify-content: center;

    padding: 30px 18px;

    border-right: 1px solid #202a2c;

    color: #36d399;

    font-size: 12px;

    text-align: center;
  }

  .education-content {
    padding: 30px;
  }

  .education-status {
    display: inline-block;

    margin-bottom: 10px;

    padding: 5px 9px;

    border: 1px solid #293437;
    border-radius: 6px;

    background: #111719;

    color: #36d399;

    font-size: 10px;

    text-transform: uppercase;

    letter-spacing: 0.6px;
  }

  .education-content h2 {
    margin: 0;

    color: #e0e4e5;

    font-family:
      Inter,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    font-size: 22px;

    font-weight: 600;

    line-height: 1.35;
  }

  .institution {
    margin: 8px 0 0;

    color: #5ca8ff;

    font-size: 14px;
  }

  .education-description {
    max-width: 760px;

    margin: 20px 0 0;

    color: #9ba4a7;

    font-family:
      Inter,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    font-size: 14px;

    line-height: 1.7;
  }

  @media (max-width: 700px) {

    .education-list {
      margin-top: 50px;
    }

    .education-card {
      grid-template-columns: 1fr;
    }

    .education-period {
      justify-content: flex-start;

      padding: 16px 22px;

      border-right: 0;
      border-bottom: 1px solid #202a2c;
    }

    .education-content {
      padding: 22px;
    }

    .education-content h2 {
      font-size: 20px;
    }

  }

</style>